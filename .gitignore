# ===== Native bindings =====
# Компилированные .so не коммитим — они собираются локально
backend/shared/native/*.so
backend/shared/native/*.pyd
# Но .pyi и __init__.py — коммитим, они часть исходников
!backend/shared/native/*.pyi
!backend/shared/native/__init__.py

